    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { outcome: 'ignored', reason: $json.priority ? 'Value is below the threshold' : 'Informational severity', dedupeKey: $json.dedupeKey } }}",
        "options": {}
      },
      "id": "758fe550-1b4e-4f2d-9d26-ecb4c523a767",
