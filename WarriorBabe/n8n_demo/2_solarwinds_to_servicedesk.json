      "position": [
        0,
        0
      ],
      "webhookId": "723bf724-6e27-4243-8a49-4eac2825f715",
      "credentials": {
        "httpHeaderAuth": {
          "id": "wbHeaderAuth0001",
          "name": "SolarWinds webhook token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
