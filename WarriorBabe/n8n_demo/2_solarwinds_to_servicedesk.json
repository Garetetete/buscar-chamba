        }
      },
      "id": "9c3c9581-5f0b-4cf9-aa00-f05414cf05e0",
      "name": "Reject invalid payload",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        480,
        192
      ]
