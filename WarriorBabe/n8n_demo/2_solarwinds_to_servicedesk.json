    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "27d15662-8b9e-42a0-bc6a-b5bbe092c4f8",
              "name": "node",
              "value": "={{ $json.body.NodeName.trim() }}",
              "type": "string"
            },
            {
              "id": "c5841abd-52ed-4c32-a333-a033395c6467",
              "name": "metric",
              "value": "={{ $json.body.MetricName.trim() }}",
              "type": "string"
            },
            {
              "id": "1913f012-027a-4743-b643-da52924f2cd3",
              "name": "value",
              "value": "={{ $json.body.MetricValue }}",
              "type": "number"
            },
            {
              "id": "67c673ee-e019-4a31-9b7d-61b5f492b5b0",
              "name": "threshold",
              "value": "={{ $json.body.Threshold }}",
              "type": "number"
            },
            {
              "id": "bb6b063a-4d5a-4d67-a89f-3e9a5290b5ee",
              "name": "severity",
              "value": "={{ $json.body.Severity ?? 'Information' }}",
              "type": "string"
            },
            {
              "id": "a529107e-0cd5-413e-97da-f615952c6943",
              "name": "message",
              "value": "={{ $json.body.Message ?? '' }}",
              "type": "string"
            },
            {
              "id": "d3a7a8f4-43b3-4464-9992-2d073cd3f24f",
              "name": "alertAt",
              "value": "={{ $json.body.TriggeredAt ?? $now.toISO() }}",
              "type": "string"
            },
            {
              "id": "630d065f-bcfe-4d62-b136-0e6e270d4ba7",
              "name": "priority",
              "value": "={{ { Critical: 'P1', Warning: 'P2' }[$json.body.Severity] ?? '' }}",
              "type": "string"
            },
            {
              "id": "b9360178-3947-4a36-b23e-2034495a5937",
              "name": "alertType",
              "value": "={{ /down|status|ping/i.test($json.body.MetricName) ? 'Availability' : /disk|volume|storage/i.test($json.body.MetricName) ? 'Capacity' : /cpu|memory|ram|load/i.test($json.body.MetricName) ? 'Performance' : 'Other' }}",
              "type": "string"
            },
            {
              "id": "9032eff0-f664-4b6e-9425-e825f1e1b5d8",
              "name": "dedupeKey",
              "value": "={{ ($json.body.NodeName.trim() + '|' + $json.body.MetricName.trim()).toLowerCase() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "f549d796-28ef-4c2f-a484-937b9959b6a3",
