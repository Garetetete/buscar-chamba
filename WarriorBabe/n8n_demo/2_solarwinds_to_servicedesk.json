            {
              "id": "707924ff-8c42-4506-9054-f8fa50f5a2da",
              "leftValue": "={{ $json.body.MetricName }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {},
        "looseTypeValidation": true
      },
      "id": "f0d5abc7-faae-4613-b3b2-6ca9de3d02d1",
      "name": "Is payload valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        256,
        0
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { error: \"validation_error\", message: \"NodeName and MetricName are required\" } }}",
        "options": {
