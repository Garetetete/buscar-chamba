{
  "id": "wbSolarwindsFlow",
  "name": "Webhook: create service desk tickets from SolarWinds alerts",
  "description": "Turns SolarWinds alerts into service desk tickets without duplicates. Business rules decide which alerts deserve a ticket, and the source of truth decides whether to create a new ticket or update the open one, so re-sending an alert is always safe. Synthetic demo: the downstream systems are mocked.",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "solarwinds-alert",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "bfdb2471-0192-4df6-ad3c-12d0ec8fec33",
      "name": "Receive SolarWinds alert",
      "type": "n8n-nodes-base.webhook",
