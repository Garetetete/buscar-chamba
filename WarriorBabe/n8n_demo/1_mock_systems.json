        0,
        192
      ],
      "webhookId": "ba3835df-a797-4ff8-a8a6-ffd51246a29d"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.sot = sd.sot || {};\nsd.desk = sd.desk || { seq: 1000, tickets: {}, outage: false };\n\nconst b = $json.body;\nconst key = String(b.key).toLowerCase();\nconst prev = sd.sot[key];\nconst isNewTicket = !prev || prev.ticketId !== b.ticketId;\nconst record = {\n  key,\n  ticketId: b.ticketId,\n  alertType: b.alertType,\n  priority: b.priority,\n  status: 'Open',\n  firstAlertAt: isNewTicket ? b.alertAt : prev.firstAlertAt,\n  lastAlertAt: b.alertAt,\n  occurrences: isNewTicket ? 1 : prev.occurrences + 1,\n};\nsd.sot[key] = record;\nreturn { json: { isNewTicket, record } };"
      },
      "id": "b6001588-aa82-4bfe-bbc9-bfec4150ddd7",
      "name": "Upsert record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        192
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "mock/aranda/create",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "58cb43ac-dcbf-4ba7-8071-fbb292efe43f",
      "name": "On create ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
