{
  "id": "wbMockSystems001",
  "name": "Webhook: mock source of truth and service desk",
  "description": "Synthetic stand-ins for the internal source-of-truth service and the Aranda service desk, so the alert workflow can be demoed without real systems. State lives in workflow static data.",
