        544,
        0
      ],
      "webhookId": "a9c356eb-4b38-45e2-8abf-b7e5adbf9b56"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nsd.sot = sd.sot || {};\nsd.desk = sd.desk || { seq: 1000, tickets: {}, outage: false };\n\nif (sd.desk.outage) {\n  return { json: { statusCode: 503, body: { error: 'service desk unavailable (simulated outage)' } } };\n}\nconst b = $json.body;\nsd.desk.seq += 1;\nconst id = 'ARD-' + sd.desk.seq;\nconst ticket = {\n  id,\n  title: b.title,\n  priority: b.priority,\n  description: b.description,\n  source: b.source,\n  status: 'Open',\n  createdAt: new Date().toISOString(),\n  updates: [],\n};\nsd.desk.tickets[id] = ticket;\nreturn { json: { statusCode: 200, body: ticket } };"
      },
      "id": "1f22c55f-07ef-41d3-94e4-705800bc3b37",
      "name": "Create ticket",
      "type": "n8n-nodes-base.code",
